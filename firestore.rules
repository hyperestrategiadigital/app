rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tudo o que não estiver liberado abaixo é negado (inclusive o backup antigo em users/{uid}, que só se vê pelo console).

    // Espaço compartilhado da Hyper. Cada pessoa é um documento em membros/{uid}
    // com papel ("admin", "basico" ou "cliente") e permissoes (["conteudo", "trafego"]).
    match /espacos/{esp} {
      function logado() { return request.auth != null; }
      function caminhoMembro() { return /databases/$(database)/documents/espacos/$(esp)/membros/$(request.auth.uid); }
      // Membro liberado: quem pediu acesso fica "pendente" e não vê nada até o admin liberar
      function membro() { return logado() && exists(caminhoMembro()) && get(caminhoMembro()).data.status == 'ativo'; }
      function dono() { return logado() && get(/databases/$(database)/documents/espacos/$(esp)).data.dono == request.auth.uid; }
      function admin() { return dono() || (membro() && get(caminhoMembro()).data.papel == 'admin'); }
      // Pessoa do cliente (papel "cliente"): não é da equipe. Só vê o portal do cliente (regras "Portal do cliente").
      function cliente() { return !dono() && membro() && get(caminhoMembro()).data.get('papel', '') == 'cliente'; }
      // O Financeiro (valores, contratos, orçamentos) é só dos administradores
      function pode(area) { return admin() || (membro() && !cliente() && area != 'financeiro' && area in get(caminhoMembro()).data.permissoes); }
      // Equipe da Hyper (dono, administradores e básicos). Clientes ficam de fora de tudo que usa ativo().
      function ativo() { return dono() || (membro() && !cliente()); }
      function eu() { return get(caminhoMembro()).data; }
      // Portal do cliente: os clientes dele e, se a lista "marcas" tiver itens, só essas marcas
      function clientesDele() { return eu().get('clientes', []); }
      function marcasDele() { return eu().get('marcas', []); }
      function postDoCliente(d) {
        return d.get('tipo', '') == 'Conteúdo'
          && ((marcasDele().size() > 0 && d.get('marcaId', '') in marcasDele())
              || (marcasDele().size() == 0 && d.get('clienteId', '') in clientesDele()));
      }
      // Acesso por cliente: "todos" (padrão) ou "alguns" (só os ids em membros/{uid}.clientes).
      // Itens sem cliente ("") ficam visíveis para todos; no financeiro, só para quem vê todos.
      function todosClientes() { return admin() || eu().get('acessoClientes', 'todos') != 'alguns'; }
      function doCliente(cid) { return todosClientes() || cid == '' || cid in eu().get('clientes', []); }
      function doClienteEstrito(cid) { return todosClientes() || (cid != '' && cid in eu().get('clientes', [])); }
      function cli(d) { return d.get('clienteId', ''); }
      // Leitura (inclusive de listas/consultas): compara o campo direto, para o Firestore conseguir
      // conferir a consulta filtrada por clienteId. Documento sem clienteId não aparece para quem vê só alguns.
      function podeLer(d) { return todosClientes() || d.clienteId == '' || d.clienteId in eu().get('clientes', []); }
      function podeLerEstrito(d) { return todosClientes() || d.clienteId in eu().get('clientes', []); }
      // Convite: o administrador cadastra o e-mail antes; no primeiro acesso a pessoa já entra liberada
      function emailLogado() { return request.auth.token.email.lower(); }
      function caminhoConvite() { return /databases/$(database)/documents/espacos/$(esp)/convites/$(emailLogado()); }
      function conviteValido(novo) {
        return logado() && request.auth.token.email_verified == true && exists(caminhoConvite())
          && novo.status == 'ativo'
          && novo.papel == get(caminhoConvite()).data.papel
          && novo.permissoes == get(caminhoConvite()).data.permissoes
          && novo.get('acessoClientes', 'todos') == get(caminhoConvite()).data.get('acessoClientes', 'todos')
          && novo.get('clientes', []) == get(caminhoConvite()).data.get('clientes', [])
          && novo.get('marcas', []) == get(caminhoConvite()).data.get('marcas', []);
      }

      // O documento do espaço: qualquer pessoa logada lê (para saber se existe e pedir acesso).
      // O espaço da Hyper já existe: ninguém cria outro (evita uso do banco por contas de fora).
      allow read: if logado() && esp == 'hyper';
      allow update: if dono() || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailUrl']));

      match /membros/{uid} {
        allow read: if ativo() || (logado() && request.auth.uid == uid);
        // Pedido de acesso: a pessoa cria o próprio cadastro, sempre pendente, básica e sem áreas.
        // Com convite: entra direto com o que o administrador definiu.
        allow create: if (logado() && request.auth.uid == uid
                          && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'permissoes', 'status', 'criadoEm', 'pedido'])
                          && request.resource.data.get('nome', '').size() <= 120
                          && request.resource.data.papel == 'basico'
                          && request.resource.data.permissoes.size() == 0
                          && request.resource.data.status == 'pendente'
                          && !('clientes' in request.resource.data))
                      || (request.auth.uid == uid && conviteValido(request.resource.data))
                      || admin();
        // A própria pessoa muda nome, foto e pedidos de acesso; papel, áreas, clientes e liberação só o administrador
        allow update: if admin()
                      || (logado() && request.auth.uid == uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'email', 'foto', 'pedido', 'resumoDiario', 'emailAgenda', 'atualizadoEm']));
        allow delete: if admin();
      }

      match /convites/{email} {
        allow read: if admin() || (logado() && emailLogado() == email);
        allow create, update: if admin();
        allow delete: if admin() || (logado() && emailLogado() == email);
      }

      // Dados por cliente (quem tem acesso só a alguns clientes vê só os deles)
      match /clientes/{id} {
        allow read: if (ativo() && doCliente(id)) || (cliente() && id in clientesDele());
        allow write: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(id);
      }
      match /marcas/{id} {
        allow read: if (ativo() && podeLerEstrito(resource.data))
                    || (cliente() && ((marcasDele().size() > 0 && id in marcasDele()) || (marcasDele().size() == 0 && resource.data.clienteId in clientesDele())));
        allow create: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(cli(request.resource.data));
        allow update: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(cli(resource.data)) && doClienteEstrito(cli(request.resource.data));
        allow delete: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(cli(resource.data));
      }
      match /tarefas/{id} {
        allow read: if (ativo() && podeLer(resource.data)) || (cliente() && postDoCliente(resource.data));
        allow delete: if ativo() && doCliente(cli(resource.data));
        allow create: if ativo() && doCliente(cli(request.resource.data));
        allow update: if ativo() && doCliente(cli(resource.data)) && doCliente(cli(request.resource.data));
        // Cliente sugere um post (entra como ideia, para a equipe produzir)
        allow create: if cliente() && postDoCliente(request.resource.data)
                      && request.resource.data.statusConteudo == 'ideia' && request.resource.data.status == 'a_fazer'
                      && request.resource.data.keys().hasOnly(['tipo', 'clienteId', 'marcaId', 'titulo', 'dataPublicacao', 'prazo', 'formato', 'rede', 'copy', 'notas', 'statusConteudo', 'status', 'responsavel', 'sugeridoPeloCliente', 'criadoEm']);
        // Cliente aprova ou pede ajuste num post que está em aprovação, sem mexer em mais nada
        allow update: if cliente() && postDoCliente(resource.data)
                      && resource.data.get('statusConteudo', '') == 'aprovacao'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusConteudo', 'status', 'aprovacaoCliente', 'atualizadoEm'])
                      && ((request.resource.data.statusConteudo == 'aprovado' && request.resource.data.status == 'andamento')
                          || (request.resource.data.statusConteudo == 'producao' && request.resource.data.status == 'andamento'));

        // Comentários e histórico: quem vê a tarefa vê e comenta; cada um apaga só o seu (o administrador, qualquer um)
        function tarefa() { return get(/databases/$(database)/documents/espacos/$(esp)/tarefas/$(id)).data; }
        match /atividade/{a} {
          allow read: if (ativo() && podeLer(tarefa())) || (cliente() && postDoCliente(tarefa()));
          allow create: if (ativo() || (cliente() && postDoCliente(tarefa()))) && request.resource.data.uid == request.auth.uid
                        && (cliente() || doCliente(cli(tarefa())))
                        && request.resource.data.texto is string && request.resource.data.texto.size() <= 3000;
          allow delete: if admin() || (ativo() && resource.data.uid == request.auth.uid);
        }
      }
      // Tarefas concluídas há mais de 90 dias: leitura como as tarefas; só o administrador arquiva e mexe
      match /tarefasArquivo/{id} {
        allow read: if ativo() && podeLer(resource.data);
        allow write: if admin();
      }
      match /compromissos/{id} {
        allow read: if ativo() && podeLer(resource.data);
        allow delete: if ativo() && doCliente(cli(resource.data));
        allow create: if ativo() && doCliente(cli(request.resource.data));
        allow update: if ativo() && doCliente(cli(resource.data)) && doCliente(cli(request.resource.data));
      }
      // Campanhas (Natal, Black Friday, lançamentos…): agrupam posts e tarefas; só a equipe vê
      match /campanhas/{id} {
        allow read: if ativo() && podeLerEstrito(resource.data);
        allow delete: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(cli(resource.data));
        allow create: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(cli(request.resource.data));
        allow update: if (admin() || pode('conteudo') || pode('trafego')) && doClienteEstrito(cli(resource.data)) && doClienteEstrito(cli(request.resource.data));
      }
      match /recorrencias/{id} {
        allow read: if ativo() && podeLer(resource.data);
        allow write: if admin();
      }

      // Conteúdo
      match /clientes/{id}/artes/{arte} {
        allow read, write: if pode('conteudo') && doCliente(id);
        // Cliente vê os criativos dos posts dele (para aprovar); com marcas limitadas, só os dessas marcas
        // (cada criativo guarda o marcaId do post; a consulta vem filtrada por marcaId)
        allow read: if cliente() && id in clientesDele()
                    && (marcasDele().size() == 0 || resource.data.marcaId in marcasDele());
      }

      // Tráfego pago
      match /contasAds/{id} {
        allow read: if pode('trafego') && podeLerEstrito(resource.data);
        allow delete: if pode('trafego') && doClienteEstrito(cli(resource.data));
        allow create: if pode('trafego') && doClienteEstrito(cli(request.resource.data));
        allow update: if pode('trafego') && doClienteEstrito(cli(resource.data)) && doClienteEstrito(cli(request.resource.data));
      }
      match /manutencoes/{id} {
        allow read: if pode('trafego') && podeLerEstrito(resource.data);
        allow delete: if pode('trafego') && doClienteEstrito(cli(resource.data));
        allow create: if pode('trafego') && doClienteEstrito(cli(request.resource.data));
        allow update: if pode('trafego') && doClienteEstrito(cli(resource.data)) && doClienteEstrito(cli(request.resource.data));
      }

      // Financeiro (valores dos clientes)
      match /contratos/{id} { allow read, write: if pode('financeiro') && doClienteEstrito(id); }
      match /financeiro/{id} {
        allow read: if pode('financeiro') && podeLerEstrito(resource.data);
        allow delete: if pode('financeiro') && doClienteEstrito(cli(resource.data));
        allow create: if pode('financeiro') && doClienteEstrito(cli(request.resource.data));
        allow update: if pode('financeiro') && doClienteEstrito(cli(resource.data)) && doClienteEstrito(cli(request.resource.data));
      }
      match /orcamentos/{id} {
        allow read: if pode('financeiro') && podeLerEstrito(resource.data);
        allow delete: if pode('financeiro') && doClienteEstrito(cli(resource.data));
        allow create: if pode('financeiro') && doClienteEstrito(cli(request.resource.data));
        allow update: if pode('financeiro') && doClienteEstrito(cli(resource.data)) && doClienteEstrito(cli(request.resource.data));
      }

      // Lixeira: quem exclui guarda a cópia; só o administrador vê e restaura. Quem excluiu pode desfazer na hora.
      match /lixeira/{id} {
        allow read: if admin();
        allow create: if ativo() && request.resource.data.excluidoPorUid == request.auth.uid && doCliente(cli(request.resource.data));
        allow delete: if admin() || (ativo() && resource.data.excluidoPorUid == request.auth.uid);
      }

      // Registro de erros: quem tem cadastro no espaço (mesmo pendente) grava o próprio erro; só o administrador lê
      match /erros/{id} {
        allow create: if logado() && (dono() || exists(caminhoMembro())) && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['msg', 'detalhe', 'rota', 'uid', 'email', 'navegador', 'em'])
                      && request.resource.data.msg.size() <= 200 && request.resource.data.detalhe.size() <= 1500;
        allow read, delete: if admin();
      }

      // Aprovação do cliente por link: quem tem o link (token) vê os posts e responde, sem login, até expirar
      match /aprovacoes/{token} {
        function aprovacao() { return get(/databases/$(database)/documents/espacos/$(esp)/aprovacoes/$(token)).data; }
        function linkValido() { return aprovacao().expiraEm > request.time.toMillis(); }
        allow get: if resource.data.expiraEm > request.time.toMillis() || (pode('conteudo') && doClienteEstrito(cli(resource.data)));
        allow list: if pode('conteudo') && podeLerEstrito(resource.data);
        allow create, update: if pode('conteudo') && doClienteEstrito(cli(request.resource.data));
        allow delete: if pode('conteudo') && doClienteEstrito(cli(resource.data));
        match /artes/{postId} {
          allow read: if linkValido() || pode('conteudo');
          allow write: if pode('conteudo');
        }
        match /respostas/{postId} {
          allow read: if linkValido() || pode('conteudo');
          // O cliente responde só sobre os posts do link, sem mexer em mais nada
          allow create, update: if linkValido() && postId in aprovacao().postIds
                                && request.resource.data.keys().hasOnly(['status', 'comentario', 'nome', 'em'])
                                && request.resource.data.status in ['aprovado', 'ajuste']
                                && request.resource.data.comentario.size() <= 2000
                                && request.resource.data.nome.size() <= 80;
          // A equipe marca a resposta como aplicada e limpa respostas antigas
          allow update: if pode('conteudo') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aplicadaEm']);
          allow delete: if pode('conteudo');
        }
      }

      // Configurações: o envio de e-mails só para administradores; o comercial (preços, despesas fixas, modelo de
      // contrato) só para quem tem Financeiro e vê todos os clientes; o resto (equipe, listas, manual), a equipe lê
      match /config/{doc} {
        allow read: if (doc == 'email' && admin())
          || (doc == 'comercial' && pode('financeiro') && todosClientes())
          || (!(doc in ['openai', 'email', 'comercial']) && ativo())
          || (doc in ['meta', 'listas', 'manual'] && cliente());
        allow write: if admin();
      }

      // Coisas pessoais de cada um da equipe (ex.: Google Agenda conectada)
      match /pessoal/{uid}/{documento=**} {
        allow read, write: if ativo() && request.auth.uid == uid;
      }
    }
  }
}
