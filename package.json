{
  "name": "hyper-app",
  "private": true,
  "description": "App da Hyper. Este package.json é só para os testes (o site não tem build).",
  "scripts": {
    "test": "npm run test:regras && npm run test:telas",
    "test:regras": "firebase emulators:exec --only firestore --project demo-hyper \"node --test testes/regras.test.mjs\"",
    "test:telas": "playwright test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0"
  }
}
